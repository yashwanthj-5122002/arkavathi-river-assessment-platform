# Arkavati River Pollution Assessment Project - production configuration
ARKAVATI_PRODUCTION=true
ARKAVATI_PROJECT_TITLE=Arkavati River Pollution Assessment Project
ARKAVATI_HOST=127.0.0.1
ARKAVATI_PORT=8766

# Set after you know the final HTTPS address, e.g. https://arkavati.example.gov.in
ARKAVATI_PUBLIC_URL=

# Set true ONLY when the app is behind a trusted reverse proxy such as Nginx/IIS/Cloudflare Tunnel.
ARKAVATI_TRUST_PROXY=false
ARKAVATI_SECURE_COOKIES=auto
ARKAVATI_COOKIE_SAMESITE=Lax
ARKAVATI_SESSION_HOURS=12

# Leave empty for recommended same-origin production deployment.
# If UI and API are on separate origins, comma-separate the exact HTTPS origins.
ARKAVATI_ALLOWED_ORIGINS=

ARKAVATI_DEBUG_ERRORS=false
ARKAVATI_LOGIN_MAX=5
ARKAVATI_LOGIN_WINDOW_SECONDS=600
ARKAVATI_MAX_JSON_BYTES=1000000
ARKAVATI_MAX_ATTACHMENT_MB=15

# Optional path overrides. Defaults are inside the application folder.
# ARKAVATI_DATA_DIR=D:\ArkavatiData
# ARKAVATI_SHOWCASE_VIDEO_DIR=D:\ArkavatiData\showcase_videos
# ARKAVATI_VIDEO_SRT_LIBRARY_DIR=D:\ArkavatiData\video_srt_pairs
# ARKAVATI_IMPORTS_DIR=D:\ArkavatiData\imports
# ARKAVATI_BACKUPS_DIR=D:\ArkavatiData\backups
